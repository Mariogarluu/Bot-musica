# ==========================================
# 🎵 Variables de Entorno - Bot de Música
# ==========================================

# Token de autenticación del Bot de Discord (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=tu_discord_bot_token_aqui

# Application ID / Client ID (Developer Portal -> General Information -> Application ID)
CLIENT_ID=tu_client_id_aqui

# ID del servidor de Discord (Guild ID) para despliegue instantáneo de comandos Slash
GUILD_ID=tu_guild_id_aqui

# Puerto del servidor HTTP interno de estado (Opcional, por defecto: 3000)
PORT=3000

# Cookie de YouTube (Opcional, útil si YouTube solicita verificación de bot o edad)
# YT_COOKIE="CONSENT=YES+...; PREF=...; SID=...; HSID=..."
